{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo nextest *)",
      "Bash(cargo test *)",
      "Bash(cargo tree *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "in=$(cat); root=$(git -C \"$(printf '%s' \"$in\" | jq -r .cwd)\" rev-parse --show-toplevel 2>/dev/null) || exit 0; [ -x \"$root/.claude/hooks/zones.sh\" ] || exit 0; printf '%s' \"$in\" | \"$root/.claude/hooks/zones.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); case \"$f\" in */tests/*/diagnostics/*) ;; *.rs) [ -f \"$f\" ] && rustfmt --edition 2024 \"$f\" >/dev/null 2>&1 ;; esac; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
