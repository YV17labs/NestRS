# Write zones: which subagent may Edit or Write which paths, one line per
# pattern. .claude/hooks/zones.sh reads this file on every Edit or Write a
# subagent makes and refuses a path its role does not own. The lead (the main
# session) carries no role and is not checked; neither is a path outside the
# repository. `*` stays inside one path segment, `**` crosses segments; a
# subagent whose role has no line here writes nothing in the repository.
#
# role      pattern
qa          crates/*/tests/**
qa          demo/apps/*/tests/**
qa          demo/crates/*/tests/**
qa          .config/nextest.toml
security    crates/*/tests/**
security    demo/apps/*/tests/**
security    demo/crates/*/tests/**
