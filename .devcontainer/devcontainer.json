{
	"name": "nestrs",
	"dockerComposeFile": "docker-compose.yml",
	"service": "dev",
	"workspaceFolder": "/workspaces/nestrs",
	"postCreateCommand": "cargo install --locked --path crates/nest-rs-cli",
	// Extensions are installed in the container; every setting lives in the
	// committed `.vscode/settings.json`, which the container mounts with the
	// workspace. Keep this list in sync with `.vscode/extensions.json`.
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"vadimcn.vscode-lldb",
				"fill-labs.dependi",
				"tombi-toml.tombi",
				"usernamehw.errorlens",
				"ryanluker.vscode-coverage-gutters",
				"nefrob.vscode-just-syntax",
				"mtxr.sqltools",
				"mtxr.sqltools-driver-pg",
				"graphql.vscode-graphql-syntax",
				"astro-build.astro-vscode",
				"unifiedjs.vscode-mdx",
				"bierner.markdown-mermaid",
				"anthropic.claude-code"
			]
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"configureZshAsDefaultShell": true,
			"installOhMyZsh": true
		}
	},
	"forwardPorts": [
		3001,
		3002,
		3003,
		3004,
		4321
	],
	"portsAttributes": {
		"3001": {
			"label": "auth"
		},
		"3002": {
			"label": "api"
		},
		"3003": {
			"label": "assistant"
		},
		"3004": {
			"label": "live"
		},
		"4321": {
			"label": "docs"
		}
	}
}