# https://editorconfig.org — the whitespace every editor writes, so a diff
# carries the change and nothing else. rustfmt owns `.rs`; this covers the rest.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,mjs,js,ts,toml.tpl}]
indent_size = 2

[*.md]
# A trailing double space is a Markdown line break.
trim_trailing_whitespace = false

[{Justfile,*.just}]
indent_size = 4

[Makefile]
indent_style = tab
