# Rust build artifacts (root framework workspace + demo/ product workspace)
/target
/demo/target
**/*.rs.bk

# Coverage output (cargo-llvm-cov)
*.profraw
*.profdata
/coverage
lcov.info

# Local environment / secrets. The committed cascade (`.env`, `.env.<env>`) holds
# only non-secret overrides; per-machine secrets go in `.local` files, never committed.
.env.local
.env.*.local

# Editor / IDE
.idea/
*.iml
*.swp
*.swo

# Claude Code local settings + transient worktrees
.claude/settings.local.json
.claude/worktrees/

# OS noise
.DS_Store
Thumbs.db

# Docs site (Astro / Starlight)
docs/node_modules/
docs/dist/
docs/.astro/

# Bench harness — SUT build artifacts, and the runs themselves: a result is
# only meaningful with the machine that produced it, so runs stay local.
/bench/sut/nestrs/target/
/bench/sut/*/node_modules/
/bench/sut/*/dist/
/bench/results/*
!/bench/results/.gitkeep

# Working documents — a session's own scratch record, not the repo's. `AUDIT.md`
# carried a finished campaign; `GAPS.md` is its successor and carries the open
# one. Both are a working state rather than a decision: what a session proves
# lands in the code, in a test, or in `.claude/rules/` — never as a file the
# repo has to keep in sync with itself.
AUDIT.md
GAPS.md
