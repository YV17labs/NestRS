{
	// --- rust-analyzer ---------------------------------------------------
	// Auto-discovery only finds the root workspace.
	"rust-analyzer.linkedProjects": [
		"Cargo.toml",
		"demo/Cargo.toml"
	],
	"rust-analyzer.files.exclude": [
		"bench/sut",
		"docs/node_modules",
		"docs/dist",
		"docs/.astro"
	],

	"rust-analyzer.check.command": "clippy",
	"rust-analyzer.check.extraArgs": ["--", "-Dwarnings"],

	"rust-analyzer.cargo.features": "all",
	"rust-analyzer.cargo.targetDir": true,

	"rust-analyzer.procMacro.enable": true,
	"rust-analyzer.cargo.buildScripts.enable": true,

	"rust-analyzer.inlayHints.closureReturnTypeHints.enable": "with_block",
	"rust-analyzer.inlayHints.lifetimeElisionHints.enable": "skip_trivial",

	// --- Formatting -------------------------------------------------------
	"editor.formatOnSave": true,
	"[rust]": {
		"editor.defaultFormatter": "rust-lang.rust-analyzer"
	},
	"[toml]": {
		"editor.defaultFormatter": "tombi-toml.tombi",
		"editor.formatOnSave": false
	},

	// --- Coverage ---------------------------------------------------------
	"coverage-gutters.coverageFileNames": ["lcov.info"],
	"coverage-gutters.coverageBaseDir": "demo",
	"coverage-gutters.showLineCoverage": true,
	"coverage-gutters.showRulerCoverage": true,
	"coverage-gutters.showGutterCoverage": true,

	// --- Postgres ---------------------------------------------------------
	"sqltools.connections": [
		{
			"name": "nestrs (devcontainer)",
			"driver": "PostgreSQL",
			"server": "postgres",
			"port": 5432,
			"database": "nestrs",
			"username": "nestrs",
			"password": "nestrs",
			"askForPassword": false,
			"previewLimit": 50
		},
		{
			"name": "nestrs (host)",
			"driver": "PostgreSQL",
			"server": "localhost",
			"port": 5432,
			"database": "nestrs",
			"username": "nestrs",
			"password": "nestrs",
			"askForPassword": false,
			"previewLimit": 50
		}
	],

	// --- Noise ------------------------------------------------------------
	"files.watcherExclude": {
		"**/target/**": true,
		"**/docs/node_modules/**": true,
		"**/docs/.astro/**": true,
		"**/bench/sut/**": true
	},
	"search.exclude": {
		"**/target": true,
		"**/docs/node_modules": true,
		"**/docs/dist": true,
		"bench/sut": true,
		"**/Cargo.lock": true
	},
	"files.associations": {
		"*.just": "just",
		"Justfile": "just"
	}
}
