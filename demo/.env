# nestrs — the demo's complete configuration, committed on purpose.
#
# The demo holds no real secret: its keypair is the repo's dev keypair (the same
# one `features::testing` uses) and its OAuth credentials are fixtures with no
# provider behind them. Nothing here is worth hiding, so nothing is split out —
# `git clone` then `nestrs run` works with no copy step and no file to prime.
# A real app keeps the secret-shaped half in a git-ignored `.env.local`; that is
# what `nestrs new` scaffolds. See https://nestrs.dev/configuration/env-cascade/.
#
# Only OVERRIDES live here, not every setting: anything omitted falls back to the
# in-code default of the owning `#[config]` struct. Real environment variables
# always win over this file.
#
# Precedence (highest first):
#   real env  >  .env.<NESTRS_ENV>.local  >  .env.local  >  .env.<NESTRS_ENV>  >  .env

# Postgres / Redis as the devcontainer exposes them (compose service hostnames).
# Running on bare metal? Point these at localhost in a git-ignored `.env.local` —
# and in `.env.test.local` too for the e2e suites, since the cascade skips
# `.env.local` under `NESTRS_ENV=test`.
NESTRS_DATABASE__URL=postgres://nestrs:nestrs@postgres:5432/nestrs
NESTRS_QUEUE__URL=redis://redis:6379

# Object storage (RustFS) as the devcontainer exposes it (compose service
# hostname `rustfs`). These demo credentials match the RustFS service defaults
# and the in-code `StorageConfig` defaults; they are wired here to exercise the
# dual-path config rule (`NESTRS_STORAGE__*` env AND the pinned struct). Real
# deployments override any of these keys.
NESTRS_STORAGE__ENDPOINT=http://rustfs:9000
NESTRS_STORAGE__REGION=us-east-1
NESTRS_STORAGE__ACCESS_KEY=nestrs
NESTRS_STORAGE__SECRET_KEY=nestrs
NESTRS_STORAGE__BUCKET=nestrs
NESTRS_STORAGE__FORCE_PATH_STYLE=true

# JWT keypair (EdDSA) — the repo's dev keypair, public by design: its private
# half is already committed for the test suites, so anyone with the repo can
# mint tokens the demo accepts. That is the point of a demo, and the reason this
# file is not a model for a deployment. Generate your own before running any of
# this for real:
#   printf 'NESTRS_AUTHN__PRIVATE_KEY="%s"\n' \
#     "$(openssl genpkey -algorithm ed25519 | sed ':a;N;$!ba;s/\n/\\n/g')"
# and supply it (with its matching public half) through the real environment.
NESTRS_AUTHN__PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIEYTRN4vmCuIfaUslO5G9pKyxkDJn3q3t9WDHo2FCfw3\n-----END PRIVATE KEY-----\n"
NESTRS_AUTHN__PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAHfPOjd2Y3m1BLM5nBJBMZFAlfWt69WL1NY8XyYeGfeo=\n-----END PUBLIC KEY-----\n"
# Token scoping. Without them any token signed by this key pair is accepted by
# any app that trusts it; with them the `api` app takes only tokens the `auth`
# app minted *for it*. `JwtService` stamps both onto every token it signs and
# requires both on every token it verifies — nothing to restate in `Claims`.
NESTRS_AUTHN__ISSUER=nestrs-demo-auth
NESTRS_AUTHN__AUDIENCE=nestrs-demo-api

# Social login providers for the `auth` issuer (nest-rs-social). The auth/token/
# userinfo endpoints are provider constants (in the crate), and scopes default to
# each provider's canonical login set when unset. These client ids and secrets
# are fixtures — no OAuth app is registered behind them, so the flow is wired but
# not live. Point them at your own provider apps to exercise it end to end.
NESTRS_SOCIAL__GITHUB__CLIENT_ID=demo-github-client-id
NESTRS_SOCIAL__GITHUB__CLIENT_SECRET=demo-github-client-secret
NESTRS_SOCIAL__GITHUB__REDIRECT_URL=http://localhost:3001/social/github/callback
NESTRS_SOCIAL__GOOGLE__CLIENT_ID=demo-google-client-id
NESTRS_SOCIAL__GOOGLE__CLIENT_SECRET=demo-google-client-secret
NESTRS_SOCIAL__GOOGLE__REDIRECT_URL=http://localhost:3001/social/google/callback

# Registered clients of the `auth` issuer's `/token` endpoint (the
# `client_credentials` grant). A JSON array; each client authenticates with HTTP
# Basic (`client_id:client_secret`) and may mint tokens only for its `org_id` and
# within its `scopes`.
NESTRS_ISSUER__CLIENTS=[{"client_id":"demo-service","client_secret":"demo-service-secret","payload":"018f0000-0000-7000-8000-000000000000","scopes":["admin","user"]}]

# OpenAPI document identity for the `api` app (title/version default to "nestrs
# API" / "0.1.0"; only the description differs from the defaults here).
NESTRS_OPENAPI__DESCRIPTION=Demo API built with nestrs
