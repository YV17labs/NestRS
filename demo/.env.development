# nestrs — development-only overrides, read only when the process declares
# NESTRS_ENV=development (or dev) — `nestrs run dev` and `nestrs run db` do; an
# unset one runs as production and never reads this file. Setting it here would
# be too late and is refused at boot.
# Committed; layered on top of `.env`, below `.env.local` and the real environment.

# Verbose, human-readable logs while developing.
NESTRS_LOG=debug
NESTRS_LOG_FORMAT=text
NESTRS_LOG_SOURCE_LOCATION=true

# GraphQL dev tooling — off by default (production-safe), turned on here for
# development: serve the playground and (re)write the committed SDL on boot. The
# SDL path targets the api app's committed file (cargo runs from the workspace root).
NESTRS_GRAPHQL__PLAYGROUND=true
NESTRS_GRAPHQL__EMIT_SDL=true
NESTRS_GRAPHQL__SCHEMA_PATH=apps/api/schema.graphql
# OpenAPI document emit — mirrors the SDL emit; keeps openapi.json fresh on dev run.
NESTRS_OPENAPI__EMIT_DOCUMENT=true
NESTRS_OPENAPI__DOCUMENT_PATH=apps/api/openapi.json
