# nestrs — development-only overrides, read only when the process declares
# NESTRS_ENV=development (or dev) — `nestrs run dev` and `nestrs run db` do; an
# unset one runs as production and never reads this file. Setting it here would
# be too late and is refused at boot.
# Committed; layered on top of `.env`, below `.env.local` and the real environment.

# Verbose logs, each line naming where it was emitted.
RUST_LOG=debug
NESTRS_LOG_SOURCE_LOCATION=true

# Postgres, Redis and RustFS as the devcontainer exposes them (compose service
# hostnames), over TLS. Running on bare metal? Point these at localhost in a
# git-ignored `.env.local` — and in `.env.test.local` too for the e2e suites,
# since the cascade skips `.env.local` under `NESTRS_ENV=test`.
NESTRS_SEAORM__URL=postgres://nestrs:nestrs@postgres:5432/nestrs
NESTRS_REDIS__URL=rediss://valkey-standalone:6379
# NESTRS_REDIS__URL=rediss-sentinel://valkey-sentinel-1:26379?node=valkey-sentinel-2:26379&node=valkey-sentinel-3:26379&sentinelServiceName=nestrs
# NESTRS_REDIS__URL=rediss-cluster://valkey-cluster-1:6379?node=valkey-cluster-2:6379&node=valkey-cluster-3:6379
# The audio feature's transcode records (`Transcodes`), each expiring on its own,
# beside the queue on database 0; the e2e suites keep theirs on `.env.test`'s 8.
NESTRS_REDIS__TRANSCODES__URL=rediss://valkey-standalone:6379
# NESTRS_REDIS__TRANSCODES__URL=rediss-sentinel://valkey-sentinel-1:26379?node=valkey-sentinel-2:26379&node=valkey-sentinel-3:26379&sentinelServiceName=nestrs
# NESTRS_REDIS__TRANSCODES__URL=rediss-cluster://valkey-cluster-1:6379?node=valkey-cluster-2:6379&node=valkey-cluster-3:6379
# The bucket the dev container creates at each start, and its RustFS's own pair.
NESTRS_STORAGE__URL=s3://nestrs
NESTRS_STORAGE__ENDPOINT=https://rustfs:9000
NESTRS_STORAGE__ACCESS_KEY=nestrs
NESTRS_STORAGE__SECRET_KEY=nestrs

# The `assistant` app's identity as an OAuth 2.1 protected resource (RFC 9728).
# `RESOURCE` is its canonical URI, what a client puts in the RFC 8707 `resource`
# parameter and the audience a token for it carries; its MCP endpoint answers
# that host. The authorization server is the demo's own `auth` app, whose issuer
# identifier every token it mints names as its `iss` — the one the assistant
# accepts. A client reads all of this from
# http://localhost:3003/.well-known/oauth-protected-resource after its first
# 401. Plain `http` on loopback passes only under this profile.
NESTRS_OAUTH__RESOURCE__RESOURCE=http://localhost:3003
NESTRS_OAUTH__RESOURCE__AUTHORIZATION_SERVERS=http://localhost:3001
NESTRS_AUTHN__ISSUER=http://localhost:3001

# Social login providers for the `auth` issuer (nest-rs-social). The auth/token/
# userinfo endpoints are provider constants (in the crate), and scopes default to
# each provider's canonical login set when unset. These client ids and secrets
# are fixtures — no OAuth app is registered behind them, so the flow is wired but
# not live. Point them at your own provider apps to exercise it end to end. The
# redirect is plain `http` on loopback, which passes only under this profile: a
# deployment sets an `https` one, or leaves both providers inert.
NESTRS_SOCIAL__GITHUB__CLIENT_ID=demo-github-client-id
NESTRS_SOCIAL__GITHUB__CLIENT_SECRET=demo-github-client-secret
NESTRS_SOCIAL__GITHUB__REDIRECT_URL=http://localhost:3001/social/github/callback
NESTRS_SOCIAL__GOOGLE__CLIENT_ID=demo-google-client-id
NESTRS_SOCIAL__GOOGLE__CLIENT_SECRET=demo-google-client-secret
NESTRS_SOCIAL__GOOGLE__REDIRECT_URL=http://localhost:3001/social/google/callback
