# nestrs — test-profile overrides: the e2e suites enqueue on Redis database 1, never on a running app's 0.
NESTRS_REDIS__URL=rediss://valkey-standalone:6379/1

# The `assistant` app's identity as an OAuth 2.1 protected resource (RFC 9728).
# `RESOURCE` is its canonical URI — the same string as the audience in `.env`,
# which is what a client puts in the RFC 8707 `resource` parameter. The
# authorization server is the demo's own `auth` app. A client reads all of this
# from http://localhost:3003/.well-known/oauth-protected-resource after its
# first 401. Plain `http` on loopback passes only under this profile.
NESTRS_OAUTH__RESOURCE__RESOURCE=http://localhost:3003
NESTRS_OAUTH__RESOURCE__AUTHORIZATION_SERVERS=http://localhost:3001
