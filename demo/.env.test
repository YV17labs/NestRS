# nestrs — test-profile overrides: the e2e suites enqueue on Redis database 1, never on a running app's 0.
NESTRS_REDIS__URL=rediss://valkey-standalone:6379/1

# The `assistant` app's identity as an OAuth 2.1 protected resource, as in
# `.env.development`.
NESTRS_OAUTH__RESOURCE__RESOURCE=http://localhost:3003
NESTRS_OAUTH__RESOURCE__AUTHORIZATION_SERVERS=http://localhost:3001
