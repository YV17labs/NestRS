# nestrs — test-profile overrides, read under the NESTRS_ENV=test the harness declares.
# The devcontainer's Postgres, where each suite creates an ephemeral database.
NESTRS_SEAORM__URL=postgres://nestrs:nestrs@postgres:5432/nestrs
# The e2e suites enqueue on Redis database 1, never on a running app's 0.
NESTRS_REDIS__URL=rediss://valkey-standalone:6379/1
# The audio feature's transcode records (`Transcodes`) on database 8, apart from the queue's 1 and development's 0.
NESTRS_REDIS__TRANSCODES__URL=rediss://valkey-standalone:6379/8
# The e2e suites' objects in a bucket of their own, never in development's `nestrs`.
NESTRS_STORAGE__URL=s3://nestrs-test
NESTRS_STORAGE__ENDPOINT=https://rustfs:9000
NESTRS_STORAGE__ACCESS_KEY=nestrs
NESTRS_STORAGE__SECRET_KEY=nestrs

# The issuer `auth` stamps, as in `.env.development`.
NESTRS_AUTHN__ISSUER=http://localhost:3001
