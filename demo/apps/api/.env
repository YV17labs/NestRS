# The api's own settings, read over the workspace's `.env*` under a declared
# development or test profile only; a deployment sets its own (the chart does).
NESTRS_HTTP__PORT=3002
# No proxy in front of a local run, so the api compresses its own responses.
NESTRS_HTTP__COMPRESSION=true
# The audience a token must name to be accepted here: this app's own origin.
NESTRS_AUTHN__AUDIENCE=http://localhost:3002
