# The assistant's own settings, read over the workspace's `.env*` under a
# declared development or test profile only; a deployment sets its own.
NESTRS_HTTP__PORT=3003
# Its identity as an OAuth 2.1 protected resource (RFC 9728). `RESOURCE` is its
# canonical URI, what a client puts in the RFC 8707 `resource` parameter and the
# audience a token for it carries; its MCP endpoint answers that host. The
# authorization server is the demo's own `auth` app, whose issuer identifier
# every token it mints names as its `iss` — the one the assistant accepts. A
# client reads all of this from
# http://localhost:3003/.well-known/oauth-protected-resource after its first
# 401. Plain `http` on loopback passes under these two profiles alone: a
# deployment names its own `https` ones. The scopes it advertises are the ones
# the demo's rules gate on, declared in code (`features::authz::constants`), so
# no variable repeats them.
NESTRS_OAUTH__RESOURCE__RESOURCE=http://localhost:3003
NESTRS_OAUTH__RESOURCE__AUTHORIZATION_SERVERS=http://localhost:3001
