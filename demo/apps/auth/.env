# The issuer's own settings, read over the workspace's `.env*` under a declared
# development or test profile only; a deployment sets its own (the chart hands
# the signing key to `auth` alone, from a Secret of its own).
NESTRS_HTTP__PORT=3001
# The audience of the tokens it mints for itself: this app's own origin.
NESTRS_AUTHN__AUDIENCE=http://localhost:3001
# The signing half of the repo's dev keypair (public by design: committed for
# development), here so that `auth` alone can mint. Never a deployment's key.
NESTRS_AUTHN__PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIEYTRN4vmCuIfaUslO5G9pKyxkDJn3q3t9WDHo2FCfw3\n-----END PRIVATE KEY-----\n"
# Social login providers (nest-rs-social). The auth/token/userinfo endpoints are
# provider constants (in the crate), and scopes default to each provider's
# canonical login set when unset. These client ids and secrets are fixtures — no
# OAuth app is registered behind them, so the flow is wired but not live. Point
# them at your own provider apps to exercise it end to end. The redirect is plain
# `http` on loopback, which passes under these two profiles alone: a deployment
# sets an `https` one, or leaves both providers inert.
NESTRS_SOCIAL__GITHUB__CLIENT_ID=demo-github-client-id
NESTRS_SOCIAL__GITHUB__CLIENT_SECRET=demo-github-client-secret
NESTRS_SOCIAL__GITHUB__REDIRECT_URL=http://localhost:3001/social/github/callback
NESTRS_SOCIAL__GOOGLE__CLIENT_ID=demo-google-client-id
NESTRS_SOCIAL__GOOGLE__CLIENT_SECRET=demo-google-client-secret
NESTRS_SOCIAL__GOOGLE__REDIRECT_URL=http://localhost:3001/social/google/callback
