# The issuer's own settings, read over the workspace's `.env*` under a declared
# development or test profile only; a deployment sets its own (the chart hands
# the signing key to `auth` alone, from a Secret of its own).
NESTRS_HTTP__PORT=3001
# The audience of the tokens it mints for itself: this app's own origin.
NESTRS_AUTHN__AUDIENCE=http://localhost:3001
# The signing half of the repo's dev keypair (public by design: committed for
# development), here so that `auth` alone can mint. Never a deployment's key.
NESTRS_AUTHN__PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIEYTRN4vmCuIfaUslO5G9pKyxkDJn3q3t9WDHo2FCfw3\n-----END PRIVATE KEY-----\n"
