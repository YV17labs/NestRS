# `auth`'s committed fixtures, in a file no deployed profile reads from any directory.
# The signing half of the repo's dev keypair, so that `auth` alone can mint.
NESTRS_AUTHN__PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIEYTRN4vmCuIfaUslO5G9pKyxkDJn3q3t9WDHo2FCfw3\n-----END PRIVATE KEY-----\n"
# Its clients, each granted at most its `scopes`: posts:read, posts:write, audio:transcode.
NESTRS_OAUTH__SERVER__CLIENTS=[{"client_id":"demo-service","client_secret":"demo-service-secret","payload":{"org_id":"018f0000-0000-7000-8000-000000000000","roles":["admin"]},"scopes":["posts:read","posts:write","audio:transcode"],"resources":["http://localhost:3002","http://localhost:3003","http://localhost:3004"]}]
# The resources a sign-in may name; one naming none is minted for the first, the api.
NESTRS_SIGN_IN__RESOURCES=http://localhost:3002,http://localhost:3003,http://localhost:3004
# Social fixtures, no OAuth app behind them; plain `http` passes on loopback under these two profiles alone.
NESTRS_SOCIAL__GITHUB__CLIENT_ID=demo-github-client-id
NESTRS_SOCIAL__GITHUB__CLIENT_SECRET=demo-github-client-secret
NESTRS_SOCIAL__GITHUB__REDIRECT_URL=http://localhost:3001/social/github/callback
NESTRS_SOCIAL__GOOGLE__CLIENT_ID=demo-google-client-id
NESTRS_SOCIAL__GOOGLE__CLIENT_SECRET=demo-google-client-secret
NESTRS_SOCIAL__GOOGLE__REDIRECT_URL=http://localhost:3001/social/google/callback
