---
/**
 * Benchmark groups — NestRS 7.0 against NestJS 12.4 on its node:http adapter,
 * one group per metric.
 *
 * Data: bench/ harness, one pinned core each, medians of two rounds of five
 * timed runs — the regime that favours Node. Bar length is the real measured
 * value on a per-group shared scale (the group's largest value = 100%), so the
 * picture stays honest in both directions: for throughput NestRS is the long
 * bar; for latency, memory and cold start the Node bar grows long, which is
 * exactly the right read. NestRS is always the brand gradient and Node muted,
 * so colour means "who", never "good or bad".
 */
interface Row {
  name: string;
  value: number;
  label: string;
}

interface Group {
  title: string;
  factor: string;
  rows: Row[];
}

const NODE = 'NestJS';

const groups: Group[] = [
  {
    title: 'Hello world (T1) — 1 core, req/s',
    factor: '×1.3',
    rows: [
      { name: 'NestRS', value: 200900, label: '~201k' },
      { name: NODE, value: 154200, label: '~154k' },
    ],
  },
  {
    title: 'Guarded route (T2) — req/s',
    factor: '×2.0',
    rows: [
      { name: 'NestRS', value: 183000, label: '~183k' },
      { name: NODE, value: 93200, label: '~93k' },
    ],
  },
  {
    title: 'JSON body read (T4) — req/s',
    factor: '×2.1',
    rows: [
      { name: 'NestRS', value: 196400, label: '~196k' },
      { name: NODE, value: 93900, label: '~94k' },
    ],
  },
  {
    title: 'Latency p99, guarded route',
    factor: '×2.9',
    rows: [
      { name: 'NestRS', value: 0.46, label: '0.46 ms' },
      { name: NODE, value: 1.32, label: '1.32 ms' },
    ],
  },
  {
    title: 'Memory idle',
    factor: '×17',
    rows: [
      { name: 'NestRS', value: 6, label: '6 MB' },
      { name: NODE, value: 103, label: '103 MB' },
    ],
  },
  {
    title: 'Cold start → first 200',
    factor: '×22',
    rows: [
      { name: 'NestRS', value: 10, label: '~10 ms' },
      { name: NODE, value: 219, label: '~220 ms' },
    ],
  },
];
---

<div class="rs-bench not-content">
  {
    groups.map((g) => {
      const max = Math.max(...g.rows.map((r) => r.value));
      return (
        <div class="rs-bench-group">
          <div class="rs-bench-head">
            <span class="rs-bench-title">{g.title}</span>
            <span class="rs-bench-factor">{g.factor}</span>
          </div>
          {g.rows.map((r) => (
            <div class:list={['rs-bench-row', { 'is-nestrs': r.name === 'NestRS' }]}>
              <span class="rs-bench-who">{r.name}</span>
              <span class="rs-bench-track">
                <i class="rs-bench-fill" style={`--w:${Math.max(3, (r.value / max) * 100)}%`} />
              </span>
              <span class="rs-bench-num">{r.label}</span>
            </div>
          ))}
        </div>
      );
    })
  }
</div>

<script>
  // Bars ship at full width so a no-JS reader sees the data; JS arms the
  // from-zero grow and lets it play once, when the block scrolls into view.
  (() => {
    const bench = document.querySelector<HTMLElement>('.rs-bench');
    if (!bench) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    bench.classList.add('rs-bench--armed');
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-visible');
          obs.unobserve(e.target);
        }
      },
      { threshold: 0.25 }
    );
    io.observe(bench);
  })();
</script>
