---
/**
 * Benchmark groups — NestRS against both NestJS 11 adapters, one group per
 * metric.
 *
 * Data: bench/ harness, tier T1 (JSON through DI + injected service), one
 * pinned core, medians of repeated runs — the regime that favours Node. Bar
 * length is the real measured value on a per-group shared scale (the group's
 * largest value = 100%), so the picture stays honest in both directions: for
 * throughput NestRS is the long bar; for latency, memory and cold start the
 * Node bars grow long, which is exactly the right read. NestRS is always the
 * brand gradient and both Node adapters are muted, so colour means "who",
 * never "good or bad".
 */
interface Row {
  name: string;
  value: number;
  label: string;
}

interface Group {
  title: string;
  factor: string;
  rows: Row[];
}

const groups: Group[] = [
  {
    title: 'Throughput — 1 core, req/s',
    factor: '×2.5 vs Fastify',
    rows: [
      { name: 'NestRS', value: 241000, label: '~241k' },
      { name: 'Fastify', value: 97000, label: '~97k' },
      { name: 'Express', value: 58000, label: '~58k' },
    ],
  },
  {
    title: 'Latency p99 — lower is better',
    factor: '×3.0',
    rows: [
      { name: 'NestRS', value: 0.42, label: '0.42 ms' },
      { name: 'Fastify', value: 1.27, label: '1.27 ms' },
      { name: 'Express', value: 2.11, label: '2.11 ms' },
    ],
  },
  {
    title: 'Memory under load',
    factor: '×25',
    rows: [
      { name: 'NestRS', value: 8, label: '8 MB' },
      { name: 'Fastify', value: 198, label: '198 MB' },
      { name: 'Express', value: 206, label: '206 MB' },
    ],
  },
  {
    title: 'Cold start',
    factor: '×23',
    rows: [
      { name: 'NestRS', value: 15, label: '~15 ms' },
      { name: 'Fastify', value: 360, label: '~360 ms' },
      { name: 'Express', value: 330, label: '~330 ms' },
    ],
  },
];
---

<div class="rs-bench not-content">
  {
    groups.map((g) => {
      const max = Math.max(...g.rows.map((r) => r.value));
      return (
        <div class="rs-bench-group">
          <div class="rs-bench-head">
            <span class="rs-bench-title">{g.title}</span>
            <span class="rs-bench-factor">{g.factor}</span>
          </div>
          {g.rows.map((r) => (
            <div class:list={['rs-bench-row', { 'is-nestrs': r.name === 'NestRS' }]}>
              <span class="rs-bench-who">{r.name}</span>
              <span class="rs-bench-track">
                <i class="rs-bench-fill" style={`--w:${Math.max(3, (r.value / max) * 100)}%`} />
              </span>
              <span class="rs-bench-num">{r.label}</span>
            </div>
          ))}
        </div>
      );
    })
  }
</div>

<script>
  // Bars ship at full width so a no-JS reader sees the data; JS arms the
  // from-zero grow and lets it play once, when the block scrolls into view.
  (() => {
    const bench = document.querySelector<HTMLElement>('.rs-bench');
    if (!bench) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    bench.classList.add('rs-bench--armed');
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-visible');
          obs.unobserve(e.target);
        }
      },
      { threshold: 0.25 }
    );
    io.observe(bench);
  })();
</script>
