---
/**
 * Ascent field — one heading for the whole page: the world falls away, the
 * marks climb. Three parallax star planes everywhere; craft marks on the
 * splash only, so reading a reference page stays quiet.
 */
interface Props {
  /** Splash pages get the crafts; doc pages keep the star planes alone. */
  full?: boolean;
}

const { full = false } = Astro.props;

/**
 * The mark's outer silhouette only — never the nest (that stays on the pad
 * behind the hero), and without the inner cut: at this scale the cut turns the
 * shape into a ring, while the outer contour alone still reads as the brand.
 */
const markPath = `M0,-110
  C60,-80 88,-25 72,55
  L0,110
  L-72,55
  C-88,-25 -60,-80 0,-110Z`;

/** mulberry32 — seeded and well spread; placement must not shuffle per build. */
const rand = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

interface Layer {
  name: string;
  seed: number;
  /** Jittered grid — one star per cell, so a tile never clumps or leaves holes. */
  cols: number;
  rows: number;
  radius: [number, number];
  /** Vertical elongation — the near plane streaks, the far plane is a dot. */
  stretch: number;
  alpha: number;
}

/** One tile's worth of stars, emitted as stacked gradients and repeated. */
const starField = ({ seed, cols, rows, radius, stretch, alpha }: Layer) => {
  const next = rand(seed);
  const stars: string[] = [];
  for (let row = 0; row < rows; row++) {
    for (let col = 0; col < cols; col++) {
      const x = ((col + 0.2 + next() * 0.6) / cols) * 100;
      const y = ((row + 0.2 + next() * 0.6) / rows) * 100;
      const r = radius[0] + next() * (radius[1] - radius[0]);
      const a = alpha * (0.5 + next() * 0.5);
      stars.push(
        `radial-gradient(ellipse ${r.toFixed(2)}px ${(r * stretch).toFixed(2)}px` +
          ` at ${x.toFixed(2)}% ${y.toFixed(2)}%,` +
          ` rgb(var(--nestrs-star-rgb) / ${a.toFixed(3)}) 0,` +
          ` rgb(var(--nestrs-star-rgb) / 0) 100%)`
      );
    }
  }
  return stars.join(',');
};

const layers: Layer[] = [
  { name: 'far', seed: 7, cols: 4, rows: 4, radius: [0.6, 1.15], stretch: 1, alpha: 0.7 },
  { name: 'mid', seed: 31, cols: 3, rows: 3, radius: [0.9, 1.7], stretch: 1.8, alpha: 0.8 },
  { name: 'near', seed: 97, cols: 3, rows: 2, radius: [1.1, 2.1], stretch: 3.8, alpha: 0.92 },
];

const CRAFT_COUNT = 6;
const crafts = Array.from({ length: CRAFT_COUNT }, (_, i) => i + 1);
---

<div class:list={['nestrs-brand-bg', { 'is-full': full }]} aria-hidden="true">
  {
    layers.map((layer) => (
      <span
        class:list={['nestrs-stars', `nestrs-stars--${layer.name}`]}
        style={`background-image:${starField(layer)}`}
      />
    ))
  }

  {
    full &&
      crafts.map((n) => (
        <div class:list={['craft', `craft--${n}`]}>
          <span class="craft-plume" />
          <svg class="craft-mark" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id={`craft-grad-${n}`} x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ff4d5f" />
                <stop offset="100%" stop-color="#ff7a59" />
              </linearGradient>
            </defs>
            <g transform="translate(256,256)">
              <path d={markPath} fill={`url(#craft-grad-${n})`} />
            </g>
          </svg>
        </div>
      ))
  }
</div>
