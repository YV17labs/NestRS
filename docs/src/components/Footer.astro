---
// Extends Starlight's page footer (edit link, last updated, pagination) with
// the site-wide credit row: who built it on the left, the four places a reader
// goes next on the right.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props} />

<div class="rs-footer">
  <span>Built by <a href="https://github.com/YV17labs" rel="noopener">YV17labs</a></span>
  <nav aria-label="Elsewhere">
    <a href="https://crates.io/search?q=nest-rs" target="_blank" rel="noopener">crates.io</a>
    <a href="https://github.com/YV17labs/NestRS" target="_blank" rel="noopener">GitHub</a>
    <a href="/benchmarks/">Benchmarks</a>
    <a href="/getting-started/">Docs</a>
  </nav>
</div>
